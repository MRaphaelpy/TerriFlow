rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares seguras ────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se existe o documento ponteiro em /users/{uid}
    function hasGlobalUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Lê o congregationId do ponteiro global /users/{uid}
    function getCongId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregationId;
    }

    // Verifica se o usuário autenticado pertence à congregação acessada
    function belongsTo(congId) {
      return hasGlobalUser() && getCongId() == congId;
    }

    // Verifica se existe o perfil do usuário dentro da congregação
    function hasCongUser(congId) {
      return belongsTo(congId) &&
        exists(/databases/$(database)/documents/congregations/$(congId)/users/$(request.auth.uid));
    }

    // Obtém os dados do usuário dentro da congregação
    function getCongUser(congId) {
      return get(/databases/$(database)/documents/congregations/$(congId)/users/$(request.auth.uid)).data;
    }

    function isActiveUser(congId) {
      return hasCongUser(congId) && getCongUser(congId).active == true;
    }

    function isAdmin(congId) {
      return hasCongUser(congId) &&
        getCongUser(congId).role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin(congId) {
      return hasCongUser(congId) &&
        getCongUser(congId).role == 'SUPER_ADMIN';
    }

    // Campos que o publicador/responsável pode alterar no território
    function onlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status', 'startedAt', 'completedAt', 'returnedAt', 'updatedAt', 'notes', 'syncVersion',
          'currentResponsibleId', 'currentResponsibleName', 'currentResponsiblePhotoUrl',
          'pastResponsibleIds'
        ]);
    }

    // ── Ponteiro global /users/{uid} ──────────────────────────────────
    // Armazena apenas o congregationId (para login e roteamento)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Congregações ──────────────────────────────────────────────────
    match /congregations/{congId} {
      // Qualquer autenticado lê (necessário para buscar pelo código ao entrar)
      allow read:   if isAuthenticated();
      // Qualquer autenticado cria uma nova congregação
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin(congId);

      // ── Usuários da congregação ─────────────────────────────────────
      match /users/{userId} {
        // Leitura: o próprio usuário ou qualquer usuário ativo da congregação
        allow read: if isOwner(userId) || isActiveUser(congId);
        // Criação: próprio usuário (ao entrar/criar) ou admin
        allow create: if isOwner(userId) || isAdmin(congId);
        // Atualização: próprio usuário ou admin
        allow update: if isOwner(userId) || isAdmin(congId);
        // Remoção: apenas super_admin
        allow delete: if isSuperAdmin(congId);
      }

      // ── Territórios ─────────────────────────────────────────────────
      match /territories/{territoryId} {
        // Leitura: Qualquer membro ativo da congregação vê os territórios dela (mapa e lista)
        allow read: if isActiveUser(congId);

        // Criação: Apenas administradores criam territórios
        allow create: if isAdmin(congId);

        // Atualização: Admin pode tudo; Responsável altera apenas status/datas do seu território
        allow update: if isAdmin(congId) ||
          (isActiveUser(congId) &&
            resource.data.currentResponsibleId == request.auth.uid &&
            onlyAllowedFields());

        // Remoção: Apenas super_admin
        allow delete: if isSuperAdmin(congId);

        // ── Eventos de território ─────────────────────────────────────
        match /events/{eventId} {
          allow read: if isActiveUser(congId);

          allow create: if isAdmin(congId) ||
            (isActiveUser(congId) &&
              get(/databases/$(database)/documents/congregations/$(congId)/territories/$(territoryId))
                .data.currentResponsibleId == request.auth.uid);

          // Eventos são imutáveis após criação, mas podem ser excluídos pelo superadmin ao apagar o território
          allow delete: if isSuperAdmin(congId);
          allow update: if false;
        }
      }

      // ── Notificações ────────────────────────────────────────────────
      match /notifications/{notificationId} {
        allow read:   if belongsTo(congId) && resource.data.userId == request.auth.uid;
        allow create: if isAdmin(congId);
        allow update: if belongsTo(congId) && resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    // ── CollectionGroup de eventos (query global filtrada por congregação) ──
    match /{path=**}/events/{eventId} {
      allow read: if isAuthenticated() &&
        hasGlobalUser() &&
        resource.data.congregationId == getCongId();
    }

    // ── Device tokens FCM ─────────────────────────────────────────────
    match /deviceTokens/{tokenId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create:               if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
