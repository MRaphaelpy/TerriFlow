rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares seguras ────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se existe o documento ponteiro em /users/{uid}
    function hasGlobalUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Lê o congregationId do ponteiro global /users/{uid}
    function getCongId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.congregationId;
    }

    // Verifica se o usuário autenticado pertence à congregação acessada
    function belongsTo(congId) {
      return hasGlobalUser() && getCongId() == congId;
    }

    // Verifica se existe o perfil do usuário dentro da congregação
    function hasCongUser(congId) {
      return belongsTo(congId) &&
        exists(/databases/$(database)/documents/congregations/$(congId)/users/$(request.auth.uid));
    }

    // Obtém os dados do usuário dentro da congregação
    function getCongUser(congId) {
      return get(/databases/$(database)/documents/congregations/$(congId)/users/$(request.auth.uid)).data;
    }

    function isActiveUser(congId) {
      return hasCongUser(congId) && getCongUser(congId).active == true;
    }

    function isAdmin(congId) {
      return hasCongUser(congId) &&
        getCongUser(congId).role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin(congId) {
      return hasCongUser(congId) &&
        getCongUser(congId).role == 'SUPER_ADMIN';
    }

    // Campos que o publicador/responsável pode alterar no território
    function onlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status', 'assignedAt', 'startedAt', 'completedAt', 'returnedAt', 'updatedAt', 'notes', 'syncVersion',
          'currentResponsibleId', 'currentResponsibleName', 'currentResponsiblePhotoUrl',
          'pastResponsibleIds', 'completedBlocks'
        ]);
    }

    // ── Ponteiro global /users/{uid} ──────────────────────────────────
    // Armazena apenas o congregationId (para login e roteamento)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Congregações ──────────────────────────────────────────────────
    match /congregations/{congId} {
      // Qualquer autenticado lê (necessário para buscar pelo código ao entrar)
      allow read:   if isAuthenticated();
      // Qualquer autenticado cria uma nova congregação, registrando-se como criador
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSuperAdmin(congId);

      // ── Usuários da congregação ─────────────────────────────────────
      match /users/{userId} {
        // Leitura: o próprio usuário ou qualquer usuário ativo da congregação
        allow read: if isOwner(userId) || isActiveUser(congId);
        // Criação: admin, ou o próprio usuário como RESPONSIBLE
        // (somente o criador da congregação pode criar o próprio perfil com outro papel)
        allow create: if isAdmin(congId) ||
          (isOwner(userId) &&
            (request.resource.data.role == 'RESPONSIBLE' ||
             get(/databases/$(database)/documents/congregations/$(congId)).data.createdBy == request.auth.uid));
        // Atualização: admin, ou o próprio usuário sem alterar o próprio papel/status
        allow update: if isAdmin(congId) ||
          (isOwner(userId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active']));
        // Remoção: apenas super_admin
        allow delete: if isSuperAdmin(congId);
      }

      // ── Territórios ─────────────────────────────────────────────────
      match /territories/{territoryId} {
        // Leitura: Qualquer membro ativo da congregação vê os territórios dela (mapa e lista)
        allow read: if isActiveUser(congId);

        // Criação: Apenas administradores criam territórios
        allow create: if isAdmin(congId);

        // Atualização: Admin pode tudo; Responsável altera apenas status/datas do seu território
        allow update: if isAdmin(congId) ||
          (isActiveUser(congId) &&
            resource.data.currentResponsibleId == request.auth.uid &&
            onlyAllowedFields());

        // Remoção: administradores (mesma regra exibida no app)
        allow delete: if isAdmin(congId);

        // ── Eventos de território ─────────────────────────────────────
        match /events/{eventId} {
          allow read: if isActiveUser(congId);

          allow create: if isAdmin(congId) ||
            (isActiveUser(congId) &&
              get(/databases/$(database)/documents/congregations/$(congId)/territories/$(territoryId))
                .data.currentResponsibleId == request.auth.uid);

          // Eventos são imutáveis após criação, mas são excluídos junto com o território
          allow delete: if isAdmin(congId);
          allow update: if false;
        }

        // ── Anotações (inclui "não visitar"): só admins e o dirigente atual ──
        match /notes/{noteId} {
          function isCurrentResponsible() {
            return isActiveUser(congId) &&
              get(/databases/$(database)/documents/congregations/$(congId)/territories/$(territoryId))
                .data.currentResponsibleId == request.auth.uid;
          }

          allow read: if isAdmin(congId) || isCurrentResponsible();
          allow create: if (isAdmin(congId) || isCurrentResponsible()) &&
            request.resource.data.authorId == request.auth.uid;
          allow delete: if isAdmin(congId) || (isActiveUser(congId) && resource.data.authorId == request.auth.uid);
          allow update: if false;
        }
      }

      // ── Notificações ────────────────────────────────────────────────
      match /notifications/{notificationId} {
        // Cada notificação tem um destinatário: só ele (ou um admin) pode lê-la
        allow read: if isActiveUser(congId) &&
          (resource.data.userId == request.auth.uid || isAdmin(congId));
        // Qualquer membro ativo cria (atribuição, finalização, devolução, transferência)
        allow create: if isActiveUser(congId);
        // Apenas o destinatário atualiza a própria notificação
        allow update: if isActiveUser(congId) && resource.data.userId == request.auth.uid;
        // Admin ou superadmin pode excluir
        allow delete: if isAdmin(congId);
      }
    }

    // ── CollectionGroup de eventos (query global filtrada por congregação) ──
    match /{path=**}/events/{eventId} {
      allow read: if isAuthenticated() &&
        hasGlobalUser() &&
        resource.data.congregationId == getCongId();
    }

    // ── Device tokens FCM ─────────────────────────────────────────────
    match /deviceTokens/{tokenId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create:               if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
